{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cck-sis",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cck-sis-db",
      "database_id": "6d9d4f3a-7408-4e63-ad78-5d2619791e6b"
    }
  ],
  "observability": { "enabled": true }
}
